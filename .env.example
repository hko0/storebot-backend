# ================================================================
#  StoreBot Backend — Environment Variables
#  انسخ هذا الملف وسمّه .env واملأ القيم
# ================================================================

# مفتاح Claude API — لا تشاركه أبداً!
CLAUDE_API_KEY=sk-ant-api03-...

# رابط فيد Google Merchant XML
FEED_URL=https://yourstore.com/feed.xml

# اسم متجرك
STORE_NAME=متجري

# النطاقات المسموح لها بالاتصال بالـ API (افصل بفاصلة)
# ضع نطاق متجرك بالضبط لمنع أي شخص آخر من استخدام الـ API
ALLOWED_ORIGINS=https://yourstore.zid.store,https://yourstore.com

# كلمة سر لتحديث الكاش يدوياً (اخترها عشوائياً)
REFRESH_SECRET=change_this_to_random_string_123

# البورت (اختياري - افتراضي 3000)
PORT=3000
